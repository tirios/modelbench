   "truncated": false,
   "text": "\n\n```python\ndef count_range_sums(nums, lo, hi, min_len=1):\n    if min_len < 1:\n        raise ValueError(\"min_len must be at least 1\")\n\n    if lo > hi:\n        return 0\n\n    n = len(nums)\n    if n == 0 or min_len > n:\n        return 0\n\n    from bisect import bisect_left, bisect_right\n\n    prefix = [0] * (n + 1)\n    s = 0\n    for i, x in enumerate(nums):\n        s += x\n        prefix[i + 1] = s\n\n    vals = sorted(set(prefix))\n    m = len(vals)\n    bit = [0] * (m + 1)\n\n    bl = bisect_left\n    br = bisect_right\n    vals_l = vals\n    bit_l = bit\n    pref = prefix\n    m_l = m\n    lo_l = lo\n    hi_l = hi\n    start = min_len - 1\n    ans = 0\n\n    for j in range(n):\n        k = j - start\n        if k >= 0:\n            idx = bl(vals_l, pref[k]) + 1\n            while idx <= m_l:\n                bit_l[idx] += 1\n                idx += idx & -idx\n\n        p = pref[j + 1]\n        left = bl(vals_l, p - hi_l)\n        right = br(vals_l, p - lo_l)\n\n        if right > left:\n            sum_right = 0\n            i = right\n            while i:\n                sum_right += bit_l[i]\n                i &= i - 1\n\n            sum_left = 0\n            i = left\n            while i:\n                sum_left += bit_l[i]\n                i &= i - 1\n\n            ans += sum_right - sum_left\n\n    return ans\n```",
