:7]) and all_digits(v[8:10]):\n        y = int(v[0:4]); m = int(v[5:7]); d = int(v[8:10])\n        if valid_date(y,m,d): return f'{y:04d}-{m:02d}-{d:02d}'\n        return None\n    # D/M/YYYY\n    parts = v.split('/')\n    if len(parts) == 3 and 1 <= len(parts[0]) <= 2 and all_digits(parts[0]) and 1 <= len(parts[1]) <= 2 and all_digits(parts[1]) and len(parts[2]) == 4 and all_digits(parts[2]):\n        a = int(parts[0]); b = int(parts[1]); y = int(parts[2])\n        if valid_date(y, b, a): return f'{y:04d}-{b:02d}-{a:02d}'\n        if valid_date(y, a, b): return f'{y:04d}-{a:02d}-{b:02d}'\n        return None\n    # D Mon YYYY\n    # day\n    i = 0\n    n = len(v)\n    while i < n and v[i] in DIGITS:\n        i += 1\n    if i == 0 or i > 2:\n        return None\n    if i >= n or v[i] != ' ':\n        return None\n    j = i\n    while j < n and v[j] == ' ':\n        j += 1\n    if j == i:\n        return None\n    if j + 3 >= n: # need 3 letters and a space after? Actually if j+3 == n, no space after, invalid. Need j+3 < n and v[j+3]==' '\n        return None\n    month = v[j:j+3]\n    if not all(c in ASCII_LETTERS for c in month):\n        return None\n    if v[j+3] != ' ':\n        return None\n    k = j + 4\n    while k < n and v[k] == ' ':\n        k += 1\n    if k == j + 4:\n        return None\n    year_str = v[k:]\n    if len(year_str) != 4 or not all_digits(year_str):\n        return None\n    mon = MONTHS.get(month.lower())\n    if mon is None:\n        return None\n    y = int(year_str); d = int(v[:i])\n    if valid_date(y, mon, d): return f'{y:04d}-{mon:02d}-{d:02d}'\n    return None\n```\nNeed check `j + 3 >= n`: Suppose v = '1 Jan 2021', n=10? indices: 0 1,1 space,2 J,3 a,4 n,5 space,6 2... j=2, j+3=5 < n, v[5]==' ' ok. If v='1 Jan' n=5, j=2, j+3=5 >= n -> invalid. Good. If v='1 Ja 2021', j=2, j+3=5, v[5]==' ' ok, month 'Ja' plus? Wait month = v[2:5] = 'Ja '? Actually v: 0 '1',1 ' ',2 'J',3 'a',4 ' ',5 '2'... j+3=5, v[5]=='2' not space -> invalid. Good. 